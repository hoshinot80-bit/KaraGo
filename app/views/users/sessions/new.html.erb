<div class="auth-page">
  <div class="auth-card">
    <div class="auth-card__icon">
      <i class="fas fa-lock"></i>
    </div>
    <h2 class="auth-card__title">ログイン</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="auth-field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "メールアドレスを入力" %>
      </div>

      <div class="auth-field">
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password, autocomplete: "current-password", placeholder: "パスワードを入力" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="auth-field auth-field--checkbox">
          <label>
            <%= f.check_box :remember_me %>
            ログインしたままにする
          </label>
        </div>
      <% end %>

      <div class="auth-field">
        <%= f.submit "ログイン", class: "btn btn--primary auth-card__submit" %>
      </div>
    <% end %>

    <div class="auth-card__links">
      <%= render "users/shared/links" %>
      <p class="auth-card__switch">
        アカウントをお持ちでない方は
        <%= link_to "新規登録", new_user_registration_path %>
      </p>
    </div>
  </div>
</div>