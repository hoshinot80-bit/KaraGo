<div class="tweet-form-page">
  <div class="tweet-form-card">
    <h1 class="tweet-form-card__title">投稿の編集</h1>

    <%= form_for @tweet do |f| %>
      <div class="tweet-form-field">
        <%= f.label :song_name, "曲名" %>
        <%= f.text_field :song_name, placeholder: "曲名を入力" %>
      </div>

      <div class="tweet-form-field">
        <%= f.label :artist, "アーティスト名" %>
        <%= f.text_field :artist, placeholder: "アーティスト名を入力" %>
      </div>

      <div class="tweet-form-field">
        <%= f.label :year, "リリース年" %>
        <%= f.text_field :year, placeholder: "例）2018" %>
      </div>

      <div class="tweet-form-field">
        <%= f.label "タグ（複数選択可）" %>
        <div class="tag-checkbox-grid">
          <%= f.collection_check_boxes(:tag_ids, Tag.all, :id, :name) do |tag| %>
            <label class="tag-checkbox">
              <%= tag.check_box %>
              <%= tag.text %>
            </label>
          <% end %>
        </div>
      </div>

      <%= f.submit "更新する", class: "btn btn--primary tweet-form-card__submit" %>
    <% end %>
  </div>
</div>