<div class="auth-page">
  <div class="auth-card">
    <div class="auth-card__icon">
      <i class="fas fa-user"></i>
    </div>
    <h2 class="auth-card__title">新規登録</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
      <%= render "users/shared/error_messages", resource: resource %>

      <div class="auth-field">
        <%= f.label :name, "ニックネーム" %>
        <%= f.text_field :name, autofocus: true, placeholder: "例）カラオケ大好き" %>
      </div>

      <div class="auth-field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, autocomplete: "email", placeholder: "メールアドレスを入力" %>
      </div>

      <div class="auth-field">
        <%= f.label :password, "パスワード" %>
        <% if @minimum_password_length %>
          <span class="auth-field__hint">(<%= @minimum_password_length %>文字以上)</span>
        <% end %>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "パスワードを入力" %>
      </div>

      <div class="auth-field">
        <%= f.label :password_confirmation, "パスワード（確認用）" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "パスワードをもう一度入力" %>
      </div>

      <div class="auth-field">
        <%= f.submit "新規登録", class: "btn btn--primary auth-card__submit" %>
      </div>
    <% end %>

    <div class="auth-card__links">
      <%= render "users/shared/links" %>
      <p class="auth-card__switch">
        すでにアカウントをお持ちの方は
        <%= link_to "ログイン", new_user_session_path %>
      </p>
    </div>
  </div>
</div>
