<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Kara Go" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
   <script src="https://kit.fontawesome.com/cef2d4f2d7.js" crossorigin="anonymous"></script>
    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
<header class="site-header">
 <div class="site-header__inner">
  <%= link_to root_path, class: "site-header__logo" do %>
   <span class="site-header__logo-icon">♪</span> KaraGo
  <% end %>

  <nav class="site-header__nav">
   <%= link_to "トップページ", root_path, class: "site-header__nav-link" %>
   <%= link_to "曲一覧", tweets_path, class: "site-header__nav-link" %>
   <%= link_to "ランキング", tweets_path, class: "site-header__nav-link" %>
   <% if user_signed_in? %>
    <%= link_to "マイページ", user_path(current_user.id), class: "site-header__nav-link" %>
   <% else %>
    <%= link_to "マイページ", new_user_session_path, class: "site-header__nav-link" %>
   <% end %>
  </nav>

  <div class="site-header__actions">
   <% if user_signed_in? %>
    <%= link_to "新規投稿", new_tweet_path, class: "btn btn--primary" %>
    <div class="site-header__user-menu">
     <%= link_to user_path(current_user.id), class: "site-header__user-avatar" do %>
       <% if current_user.avatar.attached? %>
         <%= image_tag current_user.avatar, class: "site-header__user-avatar-img" %>
       <% else %>
         <i class="fas fa-user"></i>
       <% end %>
     <% end %>
     <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "site-header__nav-link site-header__logout-btn" %>
    </div>
   <% else %>
    <%= link_to "ログイン", new_user_session_path, class: "btn btn--outline" %>
    <%= link_to "新規登録", new_user_registration_path, class: "btn btn--primary" %>
   <% end %>
  </div>

  <button class="site-header__hamburger" id="hamburger-btn" aria-label="メニューを開く">
   <span></span>
   <span></span>
   <span></span>
  </button>
 </div>

 <div class="site-header__mobile-menu" id="mobile-menu">
  <%= link_to "トップページ", root_path, class: "site-header__mobile-link" %>
  <%= link_to "曲一覧", tweets_path, class: "site-header__mobile-link" %>
  <%= link_to "ランキング", tweets_path, class: "site-header__mobile-link" %>
  <% if user_signed_in? %>
   <%= link_to "マイページ", user_path(current_user.id), class: "site-header__mobile-link" %>
   <%= link_to "新規投稿", new_tweet_path, class: "site-header__mobile-link" %>
   <%= button_to "ログアウト", destroy_user_session_path, method: :delete, class: "site-header__mobile-link site-header__mobile-logout" %>
  <% else %>
   <%= link_to "ログイン", new_user_session_path, class: "site-header__mobile-link" %>
   <%= link_to "新規登録", new_user_registration_path, class: "site-header__mobile-link" %>
  <% end %>
 </div>
</header>

<script>
  function initHamburgerMenu() {
    const btn = document.getElementById("hamburger-btn");
    const menu = document.getElementById("mobile-menu");
    if (!btn || !menu) return;

    // 重複登録を防ぐため、一度だけ登録する
    if (btn.dataset.bound === "true") return;
    btn.dataset.bound = "true";

    btn.addEventListener("click", function () {
      menu.classList.toggle("site-header__mobile-menu--open");
      btn.classList.toggle("site-header__hamburger--open");
    });
  }

  document.addEventListener("DOMContentLoaded", initHamburgerMenu);
  document.addEventListener("turbo:load", initHamburgerMenu);
</script>
   <main>
    <%= yield %>
   </main>
   <footer class="site-footer">
  <div class="site-footer__main">
    <div class="site-footer__brand">
      <div class="site-footer__logo">
        <span class="site-footer__logo-icon">🎤</span> KaraGo
      </div>
      <p class="site-footer__tagline">みんなでつくる<br>カラオケ曲のシェアサイト</p>
      <p class="site-footer__description">あなたのおすすめの曲を投稿したり、みんなの曲にいいね！したり。お気に入りの一曲を見つけよう。</p>
      <%= link_to tweets_path, class: "btn btn--outline site-footer__cta" do %>
        <i class="fas fa-music"></i> 曲を探してみる
      <% end %>
    </div>

    <div class="site-footer__col">
      <h4 class="site-footer__col-title"><i class="fas fa-music"></i> メニュー</h4>
      <ul class="site-footer__links">
        <li><%= link_to root_path, class: "site-footer__link" do %><i class="fas fa-house"></i> トップページ<% end %></li>
        <li><%= link_to tweets_path, class: "site-footer__link" do %><i class="fas fa-music"></i> 曲一覧<% end %></li>
        <% if user_signed_in? %>
          <li><%= link_to user_path(current_user.id), class: "site-footer__link" do %><i class="fas fa-user"></i> マイページ<% end %></li>
          <li><%= link_to new_tweet_path, class: "site-footer__link" do %><i class="fas fa-plus"></i> 新規投稿<% end %></li>
        <% else %>
          <li><%= link_to new_user_session_path, class: "site-footer__link" do %><i class="fas fa-user"></i> マイページ<% end %></li>
        <% end %>
      </ul>
    </div>

    <% if user_signed_in? %>
      <div class="site-footer__col">
        <h4 class="site-footer__col-title"><i class="far fa-heart"></i> マイページ内メニュー</h4>
        <ul class="site-footer__links">
          <li><%= link_to user_path(current_user.id), class: "site-footer__link" do %><i class="fas fa-user"></i> マイページ<% end %></li>
          <li><%= link_to "#{user_path(current_user.id)}#posted-tweets", class: "site-footer__link" do %><i class="fas fa-pen"></i> 投稿した曲<% end %></li>
          <li><%= link_to "#{user_path(current_user.id)}#liked-tweets", class: "site-footer__link" do %><i class="far fa-heart"></i> いいねした曲<% end %></li>
          <li><%= link_to "#{user_path(current_user.id)}#want-to-sing-tweets", class: "site-footer__link" do %><i class="fas fa-bookmark"></i> 歌いたい曲<% end %></li>
          <li><%= link_to edit_user_registration_path, class: "site-footer__link" do %><i class="fas fa-pen"></i> プロフィール編集<% end %></li>
        </ul>
      </div>
    <% end %>

    <div class="site-footer__col">
  <h4 class="site-footer__col-title"><i class="fas fa-tag"></i> 人気のタグ</h4>
  <ul class="site-footer__links">
    <% ["盛り上がる", "落ち着く", "年代問わず", "友達とカラオケ", "一人カラオケ向け", "デート向け"].each do |tag_name| %>
      <% tag = Tag.find_by(name: tag_name) %>
      <% next unless tag %>
      <li>
        <%= link_to tweets_path(tag_ids: { tag.name => "1" }), class: "site-footer__link" do %>
          <%= tag_name.sub("向け", "") %>
        <% end %>
      </li>
  <% end %>
  </ul>
</div>
  </div>

  <div class="site-footer__bottom">
    <p class="site-footer__copyright">&copy; 2026 KaraGo. All rights reserved.</p>
  </div>
</footer>
<nav class="bottom-tabbar">
  <%= link_to root_path, class: "bottom-tabbar__item #{'bottom-tabbar__item--active' if current_page?(root_path)}" do %>
    <i class="fas fa-house"></i>
    <span>ホーム</span>
  <% end %>
  <%= link_to tweets_path, class: "bottom-tabbar__item #{'bottom-tabbar__item--active' if current_page?(tweets_path)}" do %>
    <i class="fas fa-list"></i>
    <span>曲一覧</span>
  <% end %>
  <%= link_to tweets_path, class: "bottom-tabbar__item" do %>
    <i class="fas fa-crown"></i>
    <span>ランキング</span>
  <% end %>
  <% if user_signed_in? %>
    <%= link_to user_path(current_user.id), class: "bottom-tabbar__item" do %>
      <i class="fas fa-user"></i>
      <span>マイページ</span>
    <% end %>
  <% else %>
    <%= link_to new_user_session_path, class: "bottom-tabbar__item" do %>
      <i class="fas fa-user"></i>
      <span>マイページ</span>
    <% end %>
  <% end %>
</nav>
  </body>
</html>