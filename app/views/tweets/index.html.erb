<div class="tweets-page">
  <div class="tweets-page__inner">
    <h1 class="tweets-page__title">曲一覧</h1>
 <div class="featured-tags-box">
  <div class="featured-tags">
    <span class="featured-tags__label">人気のタグ</span>
    <% @featured_tags.each do |tag_name| %>
      <% tag = Tag.find_by(name: tag_name) %>
      <% next unless tag %>
      <%= link_to tweets_path(tag_ids: { tag.name => "1" }), class: "featured-tag" do %>
        <%= tag_name.sub("向け", "") %>
      <% end %>
    <% end %>
  </div>
</div>

    <div class="tweets-page__layout">
      <aside class="tag-sidebar">
        <h3 class="tag-sidebar__title">タグで絞り込む</h3>
        <%= form_tag({controller: "tweets", action: "index"}, method: :get) do %>
          <ul class="tag-sidebar__list">
            <% Tag.all.each do |t| %>
              <li class="tag-sidebar__item">
                <label>
                  <%= check_box_tag "tag_ids[#{t.name}]", "1", @selected_tags.include?(t.name) %>
                  <%= t.name %>
                </label>
              </li>
            <% end %>
          </ul>
          <%= submit_tag "絞り込む", class: "btn btn--primary tag-sidebar__submit" %>
        <% end %>
      </aside>

      <div class="tweets-list-area">
        <% if @selected_tags.present? %>
          <h2 class="tweets-list-area__heading">いいねランキング：<%= @selected_tags.join("、") %></h2>
        <% else %>
          <h2 class="tweets-list-area__heading">いいねランキング</h2>
        <% end %>

        <div class="tweet-table">
          <div class="tweet-table__header">
            <span class="tweet-table__col tweet-table__col--rank">#</span>
            <span class="tweet-table__col tweet-table__col--song">曲名</span>
            <span class="tweet-table__col tweet-table__col--artist">アーティスト</span>
            <span class="tweet-table__col tweet-table__col--tags">タグ</span>
            <span class="tweet-table__col tweet-table__col--likes">いいね数</span>
          </div>

          <% @tweets.each_with_index do |t, index| %>
            <div class="tweet-table__row">
              <span class="tweet-table__col tweet-table__col--rank"><%= @offset + index + 1 %></span>
              <span class="tweet-table__col tweet-table__col--song">
  <%= link_to tweet_path(t.id), class: "tweet-table__song-cell" do %>
    <% if t.artwork_url.present? %>
      <%= image_tag t.artwork_url, class: "tweet-table__thumb" %>
    <% else %>
      <div class="tweet-table__thumb tweet-table__thumb--placeholder">
        <i class="fas fa-music"></i>
      </div>
    <% end %>
    <span class="tweet-table__song-link"><%= t.song_name %></span>
  <% end %>
</span>
              <span class="tweet-table__col tweet-table__col--artist"><%= t.artist %></span>
              <span class="tweet-table__col tweet-table__col--tags">
                <% t.tags.each do |tag| %>
                  <span class="tag-chip"><%= tag.name %></span>
                <% end %>
              </span>
              <span class="tweet-table__col tweet-table__col--likes">
                <% if user_signed_in? %>
                  <% if current_user.already_liked?(t) %>
                    <%= link_to tweet_like_path(id: t.id, tweet_id: t.id), data: { turbo_method: :delete }, class: "like-link" do %>
                      <i class="fas fa-heart"></i> <%= t.likes.count %>
                    <% end %>
                  <% else %>
                    <%= link_to tweet_likes_path(id: t.id, tweet_id: t.id), data: { turbo_method: :post }, class: "like-link" do %>
                      <i class="far fa-heart"></i> <%= t.likes.count %>
                    <% end %>
                  <% end %>
                <% else %>
                  <i class="far fa-heart"></i> <%= t.likes.count %>
                <% end %>
              </span>
            </div>
          <% end %>
        </div>

        <% if @total_pages > 1 %>
          <div class="pagination">
            <%= link_to "«", tweets_path(page: 1, tag_ids: params[:tag_ids]), class: "pagination__btn" if @current_page > 1 %>
            <%= link_to "‹", tweets_path(page: @current_page - 1, tag_ids: params[:tag_ids]), class: "pagination__btn" if @current_page > 1 %>

            <% (1..@total_pages).each do |page_num| %>
              <% if page_num == @current_page %>
                <span class="pagination__btn pagination__btn--active"><%= page_num %></span>
              <% elsif page_num == 1 || page_num == @total_pages || (page_num - @current_page).abs <= 1 %>
                <%= link_to page_num, tweets_path(page: page_num, tag_ids: params[:tag_ids]), class: "pagination__btn" %>
              <% elsif (page_num - @current_page).abs == 2 %>
                <span class="pagination__ellipsis">...</span>
              <% end %>
            <% end %>

            <%= link_to "›", tweets_path(page: @current_page + 1, tag_ids: params[:tag_ids]), class: "pagination__btn" if @current_page < @total_pages %>
            <%= link_to "»", tweets_path(page: @total_pages, tag_ids: params[:tag_ids]), class: "pagination__btn" if @current_page < @total_pages %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="tweets-page-mobile">
      <details class="mobile-tag-filter">
        <summary class="mobile-tag-filter__summary">
          <i class="fas fa-sliders"></i> タグで絞り込む
          <% if @selected_tags.present? %>
            <span class="mobile-tag-filter__count">(<%= @selected_tags.size %>)</span>
          <% end %>
        </summary>
        <%= form_tag({controller: "tweets", action: "index"}, method: :get) do %>
          <div class="mobile-tag-filter__list">
            <% Tag.all.each do |t| %>
              <label class="mobile-tag-filter__item">
                <%= check_box_tag "tag_ids[#{t.name}]", "1", @selected_tags.include?(t.name) %>
                <%= t.name %>
              </label>
            <% end %>
          </div>
          <%= submit_tag "絞り込む", class: "btn btn--primary mobile-tag-filter__submit" %>
        <% end %>
      </details>

      <% if @selected_tags.present? %>
        <h2 class="tweets-list-area__heading">いいねランキング：<%= @selected_tags.join("、") %></h2>
      <% else %>
        <h2 class="tweets-list-area__heading">いいねランキング</h2>
      <% end %>

      <div class="mobile-tweet-list">
  <% @tweets.each_with_index do |t, index| %>
    <%= link_to tweet_path(t.id), class: "mobile-tweet-item" do %>
      <span class="mobile-tweet-item__rank"><%= @offset + index + 1 %></span>
      <% if t.artwork_url.present? %>
        <%= image_tag t.artwork_url, class: "mobile-tweet-item__thumb" %>
      <% else %>
        <div class="mobile-tweet-item__thumb mobile-tweet-item__thumb--placeholder">
          <i class="fas fa-music"></i>
        </div>
      <% end %>
      <div class="mobile-tweet-item__body">
        <div class="mobile-tweet-item__top">
          <div class="mobile-tweet-item__info">
            <p class="mobile-tweet-item__song"><%= t.song_name %></p>
            <p class="mobile-tweet-item__artist"><%= t.artist %></p>
          </div>
          <span class="mobile-tweet-item__likes">
            <i class="fas fa-heart"></i> <%= t.likes.count %>
          </span>
          <i class="fas fa-chevron-right mobile-tweet-item__arrow"></i>
        </div>
        <div class="mobile-tweet-item__tags">
          <% t.tags.each do |tag| %>
            <span class="tag-chip"><%= tag.name %></span>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>

      <% if @total_pages > 1 %>
        <div class="pagination">
          <%= link_to "«", tweets_path(page: 1, tag_ids: params[:tag_ids]), class: "pagination__btn" if @current_page > 1 %>
          <%= link_to "‹", tweets_path(page: @current_page - 1, tag_ids: params[:tag_ids]), class: "pagination__btn" if @current_page > 1 %>

          <% (1..@total_pages).each do |page_num| %>
            <% if page_num == @current_page %>
              <span class="pagination__btn pagination__btn--active"><%= page_num %></span>
            <% elsif page_num == 1 || page_num == @total_pages || (page_num - @current_page).abs <= 1 %>
              <%= link_to page_num, tweets_path(page: page_num, tag_ids: params[:tag_ids]), class: "pagination__btn" %>
            <% elsif (page_num - @current_page).abs == 2 %>
              <span class="pagination__ellipsis">...</span>
            <% end %>
          <% end %>

          <%= link_to "›", tweets_path(page: @current_page + 1, tag_ids: params[:tag_ids]), class: "pagination__btn" if @current_page < @total_pages %>
          <%= link_to "»", tweets_path(page: @total_pages, tag_ids: params[:tag_ids]), class: "pagination__btn" if @current_page < @total_pages %>
        </div>
      <% end %>
    </div>

  </div>
</div>